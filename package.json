{
  "name": "marmoot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:db",
    "test:db": "node --experimental-strip-types --no-warnings supabase/tests/run.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p supabase/tests",
    "dev": "npm run dev -w @marmoot/web",
    "dev:phone": "npm run dev -w @marmoot/web -- --host",
    "preview": "npm run build && npm run preview -w @marmoot/web",
    "build": "npm run build -w @marmoot/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^5.8.0"
  }
}
