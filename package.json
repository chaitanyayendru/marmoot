{
  "name": "marmoot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:db && npm run test:poc",
    "test:db": "node --experimental-strip-types --no-warnings supabase/tests/run.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p supabase/tests && tsc -p poc/sheets",
    "dev": "npm run dev -w @marmoot/web",
    "dev:phone": "npm run dev -w @marmoot/web -- --host",
    "preview": "npm run build && npm run preview -w @marmoot/web",
    "build": "npm run build -w @marmoot/web",
    "local": "node --experimental-strip-types --no-warnings supabase/local/stack.ts",
    "test:functions": "deno test --allow-net supabase/functions",
    "setup-sql": "node --experimental-strip-types --no-warnings supabase/setup-sql.ts",
    "deploy:web": "npm run build && npx wrangler@4 pages deploy apps/web/dist --project-name marmoot",
    "wa:template": "node --experimental-strip-types --no-warnings supabase/whatsapp-template.ts",
    "test:poc": "node --experimental-strip-types --no-warnings --test poc/sheets/test/logic.test.ts poc/sheets/test/app.test.ts",
    "poc:dev": "node --experimental-strip-types --no-warnings poc/sheets/dev/harness.ts",
    "poc:formulas": "node --experimental-strip-types --no-warnings poc/sheets/test/formulas.ts /tmp/marmoot-bill.json && python3 poc/sheets/test/check-formulas.py /tmp/marmoot-bill.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^5.8.0"
  }
}
